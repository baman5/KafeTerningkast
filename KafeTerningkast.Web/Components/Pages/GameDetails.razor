@page "/games/{Id:int}"
@using System.Linq
@using System.Net.Http
@using Microsoft.AspNetCore.Components
@using KafeTerningkast.Models
@using KafeTerningkast.Web.Components.Games
@inject NavigationManager Navigation
@inject KafeTerningkast.Web.Services.GameNightService GameNightService
@inject KafeTerningkast.Web.Services.GameApiClient Api

<PageTitle>@(game?.Name ?? "Spilldetaljer")</PageTitle>

@if (isLoading)
{
    <p>Henter spill...</p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}
else if (game is null)
{
    <h1>Spillet ble ikke funnet</h1>
    <p>Det finnes ikke et spill med ID @Id.</p>
    <button class="btn btn-secondary" @onclick="BackToGames">
        Tilbake til spillhylla
    </button>
}
else
{
    <h1>@game.Name</h1>
    <p>@game.Description</p>
    <p><strong>Spillere:</strong> @game.MinPlayers–@game.MaxPlayers</p>
    <p><strong>Spilletid:</strong> @game.PlayTimeMinutes minutter</p>
    <p><strong>Kategori:</strong> @game.Category</p>
    <p><strong>Terningkast:</strong></p>

    <DiceRating Value="@currentRating"
                ValueChanged="SaveRatingAsync"
                ReadOnly="@isSavingRating" />

    <p>Valgt terningkast: @currentRating av 6</p>

    @if (ratingErrorMessage is not null)
    {
        <p class="alert alert-danger mt-2" role="alert">
            @ratingErrorMessage
        </p>
    }
    else if (ratingMessage is not null)
    {
        <p class="alert alert-success mt-2" role="status">
            @ratingMessage
        </p>
    }

    @if (IsInGameNight)
    {
        <button class="btn btn-outline-danger mt-2"
                @onclick="RemoveFromGameNight">
            Fjern fra spillekveld
        </button>
    }
    else
    {
        <button class="btn btn-success mt-2"
                @onclick="AddToGameNight">
            Legg til i spillekveld
        </button>
    }

    @if (!string.IsNullOrWhiteSpace(gameNightMessage))
    {
        <p class="mt-2" role="status">@gameNightMessage</p>
    }

    <div class="mt-3">
        <button class="btn btn-secondary" @onclick="BackToGames">
            Tilbake til spillhylla
        </button>

        @if (nextGame is not null)
        {
            <a class="btn btn-outline-primary ms-2"
               href="@($"/games/{nextGame.Id}")">
                Neste spill: @nextGame.Name
            </a>
        }
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private BoardGame? game;
    private BoardGame? nextGame;
    private int currentRating = 1;

    private bool isLoading = true;
    private bool isSavingRating;
    private string? errorMessage;
    private string? ratingMessage;
    private string? ratingErrorMessage;
    private string? gameNightMessage;

    private bool IsInGameNight =>
        game is not null &&
        GameNightService.Games.Any(selectedGame => selectedGame.Id == game.Id);

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        errorMessage = null;
        ratingMessage = null;
        ratingErrorMessage = null;
        gameNightMessage = null;
        game = null;
        nextGame = null;

        try
        {
            var allGames = await Api.GetAllAsync();
            game = await Api.GetByIdAsync(Id);

            nextGame = allGames
                .Where(candidate => candidate.Id != Id)
                .OrderBy(candidate => candidate.Id > Id ? 0 : 1)
                .ThenBy(candidate => candidate.Id)
                .FirstOrDefault();

            currentRating = game?.Rating ?? 1;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Kunne ikke hente spill fra API-et.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveRatingAsync(int newRating)
    {
        if (game is null ||
            isSavingRating ||
            newRating < 1 ||
            newRating > 6)
        {
            return;
        }

        isSavingRating = true;
        ratingMessage = null;
        ratingErrorMessage = null;

        var updatedGame = new BoardGame
        {
            Id = game.Id,
            Name = game.Name,
            MinPlayers = game.MinPlayers,
            MaxPlayers = game.MaxPlayers,
            PlayTimeMinutes = game.PlayTimeMinutes,
            Category = game.Category,
            Rating = newRating,
            Description = game.Description
        };

        try
        {
            await Api.UpdateAsync(game.Id, updatedGame);

            game = updatedGame;
            currentRating = newRating;
            ratingMessage = "Terningkastet ble lagret.";
        }
        catch (HttpRequestException)
        {
            ratingErrorMessage = "Kunne ikke lagre terningkastet via API-et.";
        }
        finally
        {
            isSavingRating = false;
        }
    }

    private void BackToGames()
    {
        Navigation.NavigateTo("/games");
    }

    private void AddToGameNight()
    {
        if (game is null)
        {
            return;
        }

        bool added = GameNightService.AddGame(game);

        gameNightMessage = added
            ? $"{game.Name} er lagt til i spillekvelden."
            : $"{game.Name} ligger allerede i spillekvelden.";
    }

    private void RemoveFromGameNight()
    {
        if (game is null)
        {
            return;
        }

        GameNightService.RemoveGame(game.Id);
        gameNightMessage = $"{game.Name} er fjernet fra spillekvelden.";
    }
}