@page "/games/{Id:int}"
@using System.Linq
@using Microsoft.AspNetCore.Components
@using KafeTerningkast.Data
@using KafeTerningkast.Models
@using KafeTerningkast.Web.Components.Games
@inject NavigationManager Navigation
@inject KafeTerningkast.Web.Services.GameNightService GameNightService

<PageTitle>@(game?.Name ?? "Spilldetaljer")</PageTitle>

@if (game is null)
{
    <h1>Spillet ble ikke funnet</h1>
    <p>Det finnes ikke et spill med ID @Id.</p>
    <button class="btn btn-secondary" @onclick="BackToGames">Tilbake til spillhylla</button>
}
else
{
    <h1>@game.Name</h1>
    <p>@game.Description</p>
    <p><strong>Spillere:</strong> @game.MinPlayers–@game.MaxPlayers</p>
    <p><strong>Spilletid:</strong> @game.PlayTimeMinutes minutter</p>
    <p><strong>Kategori:</strong> @game.Category</p>
    <p><strong>Terningkast:</strong></p>
    
    <DiceRating @bind-Value="currentRating" />
    <p>Valgt terningkast: @currentRating av 6</p>
    @if (IsInGameNight)
    {
        <button class="btn btn-outline-danger mt-2"@onclick="RemoveFromGameNight">Fjern fra spillekveld</button>
    }
    else
    {
        <button class="btn btn-success mt-2"@onclick="AddToGameNight">Legg til i spillekveld</button>
    }

    @if (!string.IsNullOrWhiteSpace(gameNightMessage))
    {
        <p class="mt-2" role="status">@gameNightMessage</p>
    }
    <button class="btn btn-secondary mt-3" @onclick="BackToGames">Tilbake til spillhylla</button>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private BoardGame? game;
    private int currentRating;

    private string? gameNightMessage;

    private bool IsInGameNight =>
        game is not null &&
        GameNightService.Games.Any(selectedGame => selectedGame.Id == game.Id);

    protected override void OnParametersSet()
    {
        game = GameData.Games.FirstOrDefault(candidate => candidate.Id == Id);
        currentRating = game?.Rating ?? 1;
    }

    private void BackToGames()
    {
        Navigation.NavigateTo("/games");
    }
    private void AddToGameNight()
    {
        if (game is null)
        {
            return;
        }

        bool added = GameNightService.AddGame(game);

        gameNightMessage = added
            ? $"{game.Name} er lagt til i spillekvelden."
            : $"{game.Name} ligger allerede i spillekvelden.";
    }

    private void RemoveFromGameNight()
    {
        if (game is null)
        {
            return;
        }

        GameNightService.RemoveGame(game.Id);
        gameNightMessage = $"{game.Name} er fjernet fra spillekvelden.";
    }
}