@using KafeTerningkast.Models
@using KafeTerningkast.Web.Components.Games

<article class="card h-100">
    <div class="card-body">
        <h2 class="card-title h5">@Game.Name</h2>
        <p class="card-text">@Game.Description</p>
        <p><strong>Spillere:</strong> @Game.MinPlayers–@Game.MaxPlayers</p>
        <p><strong>Spilletid:</strong> @Game.PlayTimeMinutes minutter</p>
        <p><strong>Kategori:</strong> @Game.Category</p>
        <p><strong>Terningkast:</strong> <DiceRating Value="@Game.Rating" ReadOnly="true" /></p>
        <a class="btn btn-outline-primary" href="@($"/games/{Game.Id}")">Se detaljer</a>
        
        @if (IsSelected)
        {
            <p class="text-success mb-2">Valgt til spillekveld</p>

            <button type="button"
                    class="btn btn-outline-danger mt-2"
                    @onclick="NotifyParentRemoveAsync">
                Fjern fra spillekveld
            </button>
        }
        else
        {
            <button type="button"
                    class="btn btn-success mt-2"
                    @onclick="NotifyParentAsync">
                Legg til i spillekveld
            </button>
        }
    
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public BoardGame Game { get; set; } = default!;

    [Parameter]
    public EventCallback<BoardGame> OnAddToGameNight { get; set; }

    private Task NotifyParentAsync()
    {
        return OnAddToGameNight.InvokeAsync(Game);
    }

    private Task NotifyParentRemoveAsync()
    {
        return OnRemoveFromGameNight.InvokeAsync(Game);
    }
    
    [Parameter]
    public EventCallback<BoardGame> OnRemoveFromGameNight { get; set; }
    
    [Parameter]
    public bool IsSelected { get; set; }
}