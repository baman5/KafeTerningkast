@using System
@implements IDisposable
@inject KafeTerningkast.Web.Services.GameNightService GameNightService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">KafeTerningkast.Web</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                Forside
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/games">
                Spillhylla
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/game-night">
                Min spillekveld
                <span class="badge bg-primary ms-2">@GameNightService.Games.Count</span>
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/admin/games">
                Administrer spill
            </NavLink>
        </div>

    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        GameNightService.Changed += HandleGameNightChanged;
    }

    private void HandleGameNightChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameNightService.Changed -= HandleGameNightChanged;
    }
}